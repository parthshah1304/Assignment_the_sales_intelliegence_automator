# Sales Intelligence Automator Configuration

# LLM Provider: 'gemini', 'openai', 'groq', or 'mock'
# If set to 'mock', the system runs offline using intelligent semantic heuristics (no API key needed!)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free from: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional, if using openai)
OPENAI_API_KEY=

# Groq API Key (Optional, if using groq)
GROQ_API_KEY=

# Model Names
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Scraping Settings
MAX_CRAWL_PAGES_PER_LEAD=3
REQUEST_TIMEOUT_SECONDS=12
DATABASE_PATH=leads.db
